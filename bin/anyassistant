#!/bin/sh
# Starts, stops and sets up the server (with launchd on the Mac, or systemd on Linux, once
# installed by install.sh).
#
#   bin/anyassistant start [server options]   e.g. --llm hermes, --lang en, --silence 0.45
#   bin/anyassistant stop
#   bin/anyassistant restart                  (like saying «restart»: stops cleanly and comes back with the same options)
#   bin/anyassistant status
#   bin/anyassistant log                      (the live log; Ctrl+C to leave)
#   bin/anyassistant pair                     a code to pair a device (with "pairing": true)
#   bin/anyassistant unpair                   forgets every paired device
#   bin/anyassistant admin-code               a code for a browser to administer it (/admin)
#   bin/anyassistant llm-key openai           an LLM's API key, into the system's keychain
#   bin/anyassistant theme list|new <name> [--from eyes]   the screen's themes
#   bin/anyassistant community entry <folder> <base-url>   a theme's or plugin's entry for the community catalog
#   bin/anyassistant plugins [requirements [--all]]   which are on, what they lack; their Python packages
#   bin/anyassistant mail add|list|test|remove   mail accounts besides Gmail (IMAP and SMTP)
#   bin/anyassistant setup [--defaults|--json] [--set key=value] [step…]   the installer's steps (again)
#   bin/anyassistant corpus fetch|status|run|baseline   the audio corpus that measures how it listens (docs/corpus.md)
#   bin/anyassistant run [server options]     in the foreground (what launchd runs)
#   bin/anyassistant version            which version is installed
#   bin/anyassistant update             installed: the new version from where it came (or the latest
#                                       release, if that copy isn't there any more), then restarts
#   bin/anyassistant uninstall [--all|--keep-data]   installed: removes it (your data, if you say so)
#
# Options also come from settings.json. The PID, the port and the log go to the cache
# folder (.build/ while developing; $ANYASSISTANT_CACHE).
# Its own folder, also when run through a link (install.sh's ~/.local/bin/anyassistant): the link's
# folder isn't the program's.
SELF="$0"
while [ -L "$SELF" ]; do
  LINKED="$(readlink "$SELF")"
  case "$LINKED" in /*) SELF="$LINKED" ;; *) SELF="$(dirname "$SELF")/$LINKED" ;; esac
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
# An installed copy says where its data and cache are (install.sh writes it).
if [ -f "$ROOT/install.env" ]; then
  set -a; . "$ROOT/install.env"; set +a
fi
LABEL="com.anyassistant.server"
AGENT="$HOME/Library/LaunchAgents/$LABEL.plist"
DOMAIN="gui/$(id -u)"
# launchd starts this copy (and not another: the development one, a second install).
# Or the AnyAssistant app runs it (its own process): then the app's menu starts and stops it.
by_app() {
  [ -f "$PID" ] || return 1
  parent=$(ps -o ppid= -p "$(cat "$PID")" 2>/dev/null | tr -d ' ')
  [ -n "$parent" ] && ps -o command= -p "$parent" 2>/dev/null | grep -q "AnyAssistant.app/Contents/MacOS/AnyAssistant"
}
UNIT="$HOME/.config/systemd/user/anyassistant.service"  # Linux
SYSTEMD=0; [ "$(uname)" = "Linux" ] && SYSTEMD=1
SERVICE=0
if [ $SYSTEMD = 0 ] && [ -f "$AGENT" ] && grep -q "<string>$ROOT/bin/anyassistant</string>" "$AGENT"; then SERVICE=1; fi
if [ $SYSTEMD = 1 ] && [ -f "$UNIT" ] && grep -q "^ExecStart=$ROOT/bin/anyassistant " "$UNIT"; then SERVICE=1; fi
PYTHON3="$(command -v python3 || echo /usr/bin/python3)"
CACHE="${ANYASSISTANT_CACHE:-${ANYASSISTANT_HOME:-$ROOT}/.build}"  # as server/paths.py
PID="$CACHE/anyassistant.pid"
LOG="$CACHE/anyassistant.log"
PORTFILE="$CACHE/anyassistant.port"

alive() { [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; }

# The port it will listen on: --port, else settings.json's, else 8080.
port_for() {
  "$PYTHON3" - "$ROOT" "$@" <<'PY'
import json, os, sys
root, args = sys.argv[1], sys.argv[2:]
for i, arg in enumerate(args):
    if arg == "--port" and i + 1 < len(args):
        print(args[i + 1]); sys.exit()
    if arg.startswith("--port="):
        print(arg.split("=", 1)[1]); sys.exit()
try:
    path = os.path.join(os.environ.get("ANYASSISTANT_HOME") or root, "settings.json")
    print(json.load(open(path)).get("port", 8080))
except (OSError, ValueError):
    print(8080)
PY
}
PORT=$(cat "$PORTFILE" 2>/dev/null || echo 8080)

case "$1" in
  version|--version)
    # Which version is installed: its release (0.2.3) if it came from one, and its build («<commits>-<hash>»).
    BUILD="$(cat "$ROOT/VERSION" 2>/dev/null || git -C "$ROOT" describe --tags --always 2>/dev/null)"
    echo "AnyAssistant ${BUILD:-?}"
    ;;
  run)
    # In the foreground, as launchd starts it (the installed service): its PID is the server's.
    shift
    mkdir -p "$CACHE"
    echo $$ > "$PID"
    port_for "$@" > "$PORTFILE"
    cd "$ROOT" || exit 1
    PYTHONUNBUFFERED=1 exec "$ROOT/.venv/bin/python" server/main.py "$@"
    ;;
  update)
    # The program again from where it was installed from, its packages, bridges and models; restarts.
    [ -f "$ROOT/install.env" ] || { echo "Only for an installed copy (in the project: git pull)."; exit 1; }
    if [ -x "$ANYASSISTANT_SOURCE/install.sh" ]; then
      exec "$ANYASSISTANT_SOURCE/install.sh" --to "$ROOT" --data "$ANYASSISTANT_HOME" --cache "$ANYASSISTANT_CACHE" --update
    fi
    # Installed from a release (curl … | sh: its copy was temporary): the latest release's.
    RELEASE="${ANYASSISTANT_RELEASE:-https://github.com/studiolxd/anyassistant/releases/latest/download}"
    curl -fsSL "$RELEASE/install.sh" | sh -s -- --to "$ROOT" --data "$ANYASSISTANT_HOME" --cache "$ANYASSISTANT_CACHE" --update
    ;;
  uninstall)
    # The program, its cache and starting with the Mac; your data only if you say so (or --all).
    [ -f "$ROOT/install.env" ] || { echo "Only for an installed copy."; exit 1; }
    DATA_TOO=0
    [ "$2" = "--all" ] && DATA_TOO=1
    if [ "$2" != "--all" ] && [ "$2" != "--keep-data" ] && [ -t 0 ]; then
      printf "Also delete your data (settings, memory, paired devices, your themes) in %s? [y/N] " "$ANYASSISTANT_HOME"
      read -r answer
      case "$answer" in y|Y|s|S|yes|sí|si) DATA_TOO=1 ;; esac
    fi
    if [ $SERVICE = 1 ] && [ $SYSTEMD = 1 ]; then
      systemctl --user disable --now anyassistant 2>/dev/null
      rm -f "$UNIT"
      systemctl --user daemon-reload 2>/dev/null
    elif [ $SERVICE = 1 ]; then
      launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null
      rm -f "$AGENT"
    elif alive; then
      kill -TERM "$(cat "$PID")" 2>/dev/null
    fi
    rm -rf "$ANYASSISTANT_CACHE"
    LINK="$HOME/.local/bin/anyassistant"  # install.sh's, if it is this copy's
    [ -L "$LINK" ] && [ "$(readlink "$LINK")" = "$ROOT/bin/anyassistant" ] && rm -f "$LINK"
    [ $DATA_TOO = 1 ] && rm -rf "$ANYASSISTANT_HOME"
    echo "AnyAssistant uninstalled$([ $DATA_TOO = 1 ] || printf '; your data stays in %s' "$ANYASSISTANT_HOME")."
    # Last, the program itself (this script is in it): from a shell that doesn't need it.
    cd / && exec /bin/sh -c "sleep 1; rm -rf \"$ROOT\""
    ;;
  setup)
    # The installer's steps (server/installer.py): bin/anyassistant setup [--defaults|--json] [--set k=v] [step…]
    shift
    cd "$ROOT" || exit 1
    exec "$ROOT/.venv/bin/python" -c 'import sys; sys.path.insert(0, "server"); import installer; sys.exit(installer.main(sys.argv[1:]))' "$@"
    ;;
  start)
    shift
    if by_app; then echo "The AnyAssistant app runs it: it is already running (its menu: Restart, Stop)."; exit 0; fi
    if alive; then echo "AnyAssistant is already running (PID $(cat "$PID"))."; exit 0; fi
    if [ $SERVICE = 1 ] && [ $SYSTEMD = 1 ] && [ $# -eq 0 ]; then  # installed with systemd: it starts it
      systemctl --user start anyassistant && echo "Starting AnyAssistant (systemd)…"; exit $?
    fi
    if [ $SERVICE = 1 ] && [ $# -eq 0 ]; then  # installed with launchd: it starts it
      launchctl bootstrap "$DOMAIN" "$AGENT" 2>/dev/null || launchctl kickstart "$DOMAIN/$LABEL"
      echo "Starting AnyAssistant (launchd)…"; exit 0
    fi
    mkdir -p "$CACHE"
    PORT=$(port_for "$@")
    echo "$PORT" > "$PORTFILE"
    cd "$ROOT" || exit 1
    if [ ! -f "$ROOT/install.env" ]; then uv sync --quiet || exit 1; fi  # while developing
    # The environment's python directly (not `uv run`), so the PID is the server's.
    PYTHONUNBUFFERED=1 nohup "$ROOT/.venv/bin/python" server/main.py "$@" >> "$LOG" 2>&1 &
    echo $! > "$PID"
    printf "Starting AnyAssistant (PID %s)" "$(cat "$PID")"
    i=0
    while [ $i -lt 120 ]; do
      if curl -s -o /dev/null "http://127.0.0.1:$PORT/"; then echo " · ready at http://127.0.0.1:$PORT"; exit 0; fi
      if ! alive; then echo " · it stopped; see $LOG"; exit 1; fi
      printf "."; sleep 1; i=$((i + 1))
    done
    echo " · taking longer than usual; see $LOG"
    ;;
  stop)
    if by_app; then echo "The AnyAssistant app runs it: stop it from its menu (or quit the app)."; exit 1; fi
    if [ $SERVICE = 1 ] && [ $SYSTEMD = 1 ]; then  # installed with systemd
      systemctl --user stop anyassistant && { rm -f "$PID"; echo "AnyAssistant stopped."; exit 0; }
    fi
    if [ $SERVICE = 1 ]; then  # installed with launchd: so it doesn't bring it back
      launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null && { rm -f "$PID"; echo "AnyAssistant stopped."; exit 0; }
    fi
    if ! alive; then echo "AnyAssistant isn't running."; rm -f "$PID"; exit 0; fi
    P=$(cat "$PID")
    kill -TERM "$P"  # clean shutdown: sessions, Claude, voice
    i=0
    while kill -0 "$P" 2>/dev/null && [ $i -lt 15 ]; do sleep 1; i=$((i + 1)); done
    if kill -0 "$P" 2>/dev/null; then
      echo "It didn't stop within 15 s: forcing it."
      pkill -KILL -P "$P" 2>/dev/null
      kill -KILL "$P" 2>/dev/null
    fi
    rm -f "$PID"
    echo "AnyAssistant stopped."
    ;;
  restart)
    if ! alive; then echo "AnyAssistant isn't running: use «$0 start»."; exit 1; fi
    kill -HUP "$(cat "$PID")"
    echo "Restarting AnyAssistant (same PID, same options)…"
    ;;
  status)
    if alive; then
      echo "AnyAssistant is running (PID $(cat "$PID")): $(curl -s -m 3 "http://127.0.0.1:$PORT/status" || echo 'no answer')"
    else
      echo "AnyAssistant isn't running."
    fi
    ;;
  log)
    tail -n 50 -f "$LOG"
    ;;
  pair)
    if ! alive; then echo "AnyAssistant isn't running."; exit 1; fi
    curl -s -m 3 -X POST "http://127.0.0.1:$PORT/pairing" | "$PYTHON3" -c '
import json, sys
try:
    d = json.load(sys.stdin)
except ValueError:
    sys.exit("Pairing is off (the plugin «pairing»), so any device can connect. Turn it on with \"plugins\": {\"pairing\": true} in settings.json.")
print("Code: %s  (valid %d minutes; type it on the device)" % (d["code"], d["seconds"] // 60))
'
    ;;
  admin-code)
    if ! alive; then echo "AnyAssistant isn't running."; exit 1; fi
    curl -s -m 3 -X POST "http://127.0.0.1:$PORT/admin/code" | "$PYTHON3" -c '
import json, sys
d = json.load(sys.stdin)
print("Admin code: %s  (valid %d minutes, for one browser): open /admin on this computer'"'"'s address and type it" % (d["code"], d["seconds"] // 60))
'
    ;;
  llm-key)
    [ -n "$2" ] || { echo "Which one: bin/anyassistant llm-key openai"; exit 2; }
    PYTHONPATH="$ROOT/server" exec "$ROOT/.venv/bin/python" -c '
import getpass, sys
import keychain
key = getpass.getpass("Its API key (not shown; empty: forget it): ").strip()
if key:
    keychain.put("AnyAssistant LLM", sys.argv[1], key); print("Saved in the keychain: say «usa %s»." % sys.argv[1])
else:
    keychain.forget("AnyAssistant LLM", sys.argv[1]); print("Forgotten.")
' "$2"
    ;;
  plugins)
    shift
    PYTHONPATH="$ROOT/server" exec "$ROOT/.venv/bin/python" "$ROOT/server/kernel.py" "$@"
    ;;
  mail)
    shift
    PYTHONPATH="$ROOT/server" exec "$ROOT/.venv/bin/python" "$ROOT/plugins/mail/cli.py" "$@"
    ;;
  theme)
    shift
    PYTHONPATH="$ROOT/server" exec "$ROOT/.venv/bin/python" "$ROOT/plugins/page/themes.py" "$@"
    ;;
  community)
    shift
    exec "$ROOT/.venv/bin/python" "$ROOT/plugins/community/cli.py" "$@"
    ;;
  corpus)
    shift
    cd "$ROOT" || exit 1
    PYTHONPATH="$ROOT/server:$ROOT/tests" exec "$ROOT/.venv/bin/python" -m corpus "$@"
    ;;
  unpair)
    if ! alive; then echo "AnyAssistant isn't running."; exit 1; fi
    curl -s -m 3 -X POST "http://127.0.0.1:$PORT/pairing?forget=1" > /dev/null && echo "Every device forgotten: they'll need a new code."
    ;;
  *)
    sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
