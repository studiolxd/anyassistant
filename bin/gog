#!/usr/bin/python3
"""gog for Jarvis: Google (Gmail, Calendar, Drive, Docs, Sheets…) under permissions.json's policy.

    "commands": {"bin/gog": "read" | "all" | ["gmail.search", "calendar.create", …]}

Always with the «jarvis» client (its own token store), the configuration in .gog/
inside the project and never prompting. With "read" (or a read-only list) it adds
--readonly and --gmail-no-send. With "all" it allows everything except managing
gog's session (auth, login, logout…), backups, administration and self-updating.
It refuses attempts to change these options. Actions that write also go through
the voice confirmation (bin/jarvis-confirm).
"""

import json
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ME = os.path.join(ROOT, "bin", "gog")

READ = [
    "gmail.search", "gmail.get", "gmail.labels.list",
    "calendar.calendars", "calendar.events", "calendar.event", "calendar.freebusy", "calendar.conflicts",
    "drive.ls", "drive.search", "drive.get", "drive.tree",
    "docs.cat", "docs.info", "sheets.get",
]
NEVER = {"auth", "login", "logout", "backup", "admin", "update", "config"}
FORBIDDEN = ("--enable-commands", "--enable-commands-exact", "--home", "--client", "--readonly",
             "--no-readonly", "--gmail-no-send", "--access-token", "--account", "-a", "--no-input")

HELP = f"""{ME}: Google through gog. Use --plain to read.
  {ME} gmail search 'is:unread newer_than:7d' --max 10 --plain
  {ME} gmail get <messageId> --plain
  {ME} calendar events --today --all --plain   (also --tomorrow, --week, --from DATE --days N, --query text)
  {ME} calendar calendars --plain
  {ME} drive search 'text' --max 10 --plain
  {ME} drive ls --plain
  {ME} docs cat <docId>
  {ME} sheets get <spreadsheetId> 'Sheet1!A1:F30' --plain
Gmail searches use Gmail's syntax (from:, subject:, is:unread, after:2026/10/01…)."""

HELP_WRITE = f"""
It can also write ({{}}). See the options with «{ME} <service> <command> --help»; for example:
  {ME} gmail send --to x@y.com --subject 'Subject' --body 'Text'
  {ME} calendar create primary --summary 'Dentist' --from 2026-11-03T10:00 --to 2026-11-03T11:00
  {ME} drive mkdir 'Folder'
Before writing, the system asks the user for confirmation: if the call is blocked
for that reason, ask them and, if they say yes, repeat exactly the same call."""


def policy():
    try:
        with open(os.path.join(ROOT, "permissions.json")) as f:
            commands = json.load(f).get("commands", {})
    except (OSError, ValueError):
        return "read"
    if isinstance(commands, dict):
        return commands.get("bin/gog", "read")
    return "read"  # a plain list only says it may be used


def options(pol):
    base = ["--client", "jarvis", "--account", "auto", "--no-input"]
    if pol == "all":
        return base
    allowed = READ if pol == "read" else list(pol)
    base += ["--enable-commands-exact", ",".join(allowed)]
    if all(c in READ for c in allowed):
        base += ["--readonly", "--gmail-no-send"]
    elif not any(c.startswith(("gmail.send", "gmail.reply", "gmail.forward", "send")) for c in allowed):
        base += ["--gmail-no-send"]
    return base


def main():
    args = sys.argv[1:]
    pol = policy()
    if args[:1] == ["help"]:
        text = HELP
        if pol != "read":
            text += HELP_WRITE.format("all" if pol == "all" else ", ".join(pol))
        print(text)
        return
    for arg in args:
        if arg in ("-y", "--force") or arg.split("=")[0] in FORBIDDEN:
            sys.exit(f"bin/gog doesn't allow changing {arg}")
    command = next((a for a in args if not a.startswith("-")), "")
    if command in NEVER:
        sys.exit(f"bin/gog doesn't allow «{command}»")
    os.environ["GOG_HOME"] = os.path.join(ROOT, ".gog")
    os.execvp("gog", ["gog", *options(pol), *args])


if __name__ == "__main__":
    main()
