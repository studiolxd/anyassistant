#!/bin/sh
# Autoriza tu cuenta de Google para bin/gog, con los permisos que diga permisos.json:
# "bin/gog": "lectura" → solo permisos de lectura; si no, permisos completos.
#   bin/gog-autorizar tu@gmail.com
# Antes: descarga el JSON del cliente OAuth (Aplicación de escritorio) de Google
# Cloud como google-cliente.json en la raíz del proyecto.
set -e
RAIZ="$(cd "$(dirname "$0")/.." && pwd)"
export GOG_HOME="$RAIZ/.gog"
[ -n "$1" ] || { echo "Uso: $0 tu@gmail.com" >&2; exit 2; }
[ -f "$RAIZ/google-cliente.json" ] || { echo "Falta $RAIZ/google-cliente.json" >&2; exit 2; }
POLITICA=$(/usr/bin/python3 -c "
import json
try: c = json.load(open('$RAIZ/permisos.json')).get('comandos', {})
except Exception: c = {}
p = c.get('bin/gog', 'lectura') if isinstance(c, dict) else 'lectura'
print('lectura' if p == 'lectura' else 'escritura')")
LECTURA=""
[ "$POLITICA" = "lectura" ] && LECTURA="--readonly"
echo "Permisos que se piden a Google: $POLITICA"
gog --client jarvis auth credentials set "$RAIZ/google-cliente.json"
gog --client jarvis auth add "$1" --services gmail,calendar,drive,docs,sheets $LECTURA --force-consent
gog --client jarvis auth doctor --check
