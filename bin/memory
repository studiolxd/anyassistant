#!/usr/bin/python3
"""memory for Jarvis: what it remembers about you (memory.json), under permissions.json's policy.

    "commands": {"bin/memory": "all" | "read"}

Works with «memory» on in settings.json (explicit or auto). Changes go through
the voice confirmation (bin/jarvis-confirm): a misheard fact («oldev» for Holded)
is caught before it is kept, and nothing an email says can be stored without you.
"""

import json
import os
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ME = os.path.join(ROOT, "bin", "memory")
PATH = os.environ.get("JARVIS_MEMORY") or os.path.join(ROOT, "memory.json")
SETTINGS = os.environ.get("JARVIS_SETTINGS") or os.path.join(ROOT, "settings.json")


def read(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def can_write():
    commands = read(os.path.join(ROOT, "permissions.json"), {}).get("commands", {})
    return isinstance(commands, dict) and commands.get("bin/memory") == "all"


def mode():
    return read(SETTINGS, {}).get("memory", "off")


def load():
    data = read(PATH, {})
    return {"facts": data.get("facts", []), "conversations": data.get("conversations", [])}


def save(data):
    with open(PATH, "w") as f:
        f.write(json.dumps(data, ensure_ascii=False, indent=2) + "\n")


def fail(message):
    sys.exit("bin/memory: " + message)


def main():
    args = sys.argv[1:]
    command = args[0] if args else "help"
    if command == "help":
        text = ME + ": what you remember about the user.\n  " + ME + " show                 what you remember"
        if can_write():
            text += ("\n  " + ME + " remember 'fact'      keeps it for every conversation (when the user asks you to)"
                     "\n  " + ME + " forget <number>      forgets it (numbers from «show»)"
                     "\nWrite facts short, in the third person, as the user said them. Changes ask the user first.")
        print(text)
        return
    if mode() == "off":
        fail("memory is off («memory» in settings.json)")
    data = load()
    if command == "show":
        print("\n".join("%d. %s" % (i, f) for i, f in enumerate(data["facts"], 1)) or "(nothing yet)")
        if data["conversations"]:
            print("Recent conversations:")
            for c in data["conversations"]:
                print("- %s: %s" % (time.strftime("%Y-%m-%d %H:%M", time.localtime(c["at"])), c["summary"]))
        return
    if not can_write():
        fail("changing the memory is not allowed")
    if command == "remember":
        fact = " ".join(args[1:]).strip()
        if not fact:
            fail("what should I remember?")
        if fact not in data["facts"]:
            data["facts"].append(fact)
        save(data)
        print("Remembered.")
    elif command == "forget":
        try:
            del data["facts"][int(args[1]) - 1]
        except (IndexError, ValueError):
            fail("give the number of a fact from «show»")
        save(data)
        print("Forgotten.")
    else:
        fail("unknown command; see «" + ME + " help»")


if __name__ == "__main__":
    main()
