#!/usr/bin/env python3
"""Claude Code PreToolUse hook for Read: the camera's image when Claude opens it.

Claude may open the camera's image file (plugin «eyes», FRAME) to look. A device that sends no
frames (the Mac's camera is off until shown) leaves no file: then this asks the server for a
photo from the device this conversation is for (its id, the argument) and waits for it, so the
file is there when Claude reads it. Anything else Read opens goes through untouched. It never
blocks: without a photo, Claude finds no file and says the camera isn't available.
"""

import json
import os
import sys
import urllib.request

APP = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(APP, "server"))
import paths  # noqa: E402
import settings  # noqa: E402


def main():
    try:
        call = json.load(sys.stdin)
    except ValueError:
        return
    wanted = str((call.get("tool_input") or {}).get("file_path", ""))
    frame = paths.EYES / "now.jpg"
    if os.path.normpath(wanted.lstrip("/")) != os.path.normpath(str(frame).lstrip("/")) or frame.exists():
        return
    device = sys.argv[1] if len(sys.argv) > 1 else ""
    port = settings.load().get("port") or 8080
    request = urllib.request.Request(f"http://127.0.0.1:{port}/eyes/now", method="POST",
                                     data=json.dumps({"device": device}).encode(),
                                     headers={"Content-Type": "application/json"})
    try:
        urllib.request.urlopen(request, timeout=8).read()
    except OSError:
        pass  # no photo: Claude finds no file


if __name__ == "__main__":
    main()
