#!/usr/bin/python3
"""settings for Jarvis: what the LLM may change in settings.json, under permissions.json's policy.

    "commands": {"bin/settings": "all" | "read" | ["instructions", "face", "voice", "name"]}

Only these keys: never the permissions, the confirmation times, the port or the
LLM, so it cannot lift its own safeguards. Changes go through the voice
confirmation (bin/jarvis-confirm) and the server picks them up after the answer:
instructions and face at once, voice and name with a restart.
"""

import json
import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ME = os.path.join(ROOT, "bin", "settings")
PATH = os.environ.get("JARVIS_SETTINGS") or os.path.join(ROOT, "settings.json")
KEYS = ["instructions", "face", "voice", "name"]
FACES = ["eyes", "orb"]


def policy():
    try:
        with open(os.path.join(ROOT, "permissions.json")) as f:
            commands = json.load(f).get("commands", {})
    except (OSError, ValueError):
        return []
    value = commands.get("bin/settings", "read") if isinstance(commands, dict) else "read"
    if value == "all":
        return KEYS
    if value == "read":
        return []
    return [k for k in value if k in KEYS]


def load():
    try:
        with open(PATH) as f:
            return json.load(f)
    except FileNotFoundError:
        return {}


def save(data):
    with open(PATH, "w") as f:
        f.write(json.dumps(data, ensure_ascii=False, indent=2) + "\n")


def lines(data):
    value = data.get("instructions") or []
    return value.splitlines() if isinstance(value, str) else list(value)


def language():
    """The language Jarvis is speaking (the server passes it on), for per-language voices."""
    return os.environ.get("JARVIS_LANGUAGE") or load().get("language") or "en"


def voices():
    """{name: locale} of the Mac's voices, from `say -v ?`."""
    output = subprocess.run(["say", "-v", "?"], capture_output=True, text=True).stdout
    found = {}
    for line in output.splitlines():
        match = re.match(r"(.+?)\s+([a-z]{2}_[A-Z]{2})\s+#", line)
        if match:
            name = match.group(1).strip()
            found[name] = found[name.split(" (")[0]] = match.group(2)  # «Mónica (Español (España))» or «Mónica»
    return found


def help_text(allowed):
    text = f"""{ME}: your own settings. Changing them asks the user for confirmation first.
  {ME} show                       what is set now"""
    if "instructions" in allowed:
        text += f"""
  {ME} remember 'text'            keeps a line in your instructions for every conversation
                                  (what the user asks you to remember, how to talk to them…)
  {ME} forget <number>            removes that line (numbers from «show»)"""
    if "face" in allowed:
        text += f"\n  {ME} set face eyes|orb          the face on the screen"
    if "voice" in allowed:
        text += f"\n  {ME} set voice <name>           your voice in this language (restarts)"
    if "name" in allowed:
        text += f"\n  {ME} set name <name>            your name and wake word (restarts)"
    return text


def fail(message):
    sys.exit(f"bin/settings: {message}")


def main():
    args = sys.argv[1:]
    allowed = policy()
    command = args[0] if args else "help"
    data = load()

    if command == "help":
        print(help_text(allowed))
    elif command == "show":
        numbered = [f"  {i}. {line}" for i, line in enumerate(lines(data), 1)]
        print("instructions:\n" + ("\n".join(numbered) or "  (none)"))
        voice = data.get("voice")
        voice = voice.get(language()) if isinstance(voice, dict) else voice
        for key, value in (("face", data.get("face", "eyes")), ("voice", voice or "the language's"),
                           ("name", data.get("name", "Jarvis"))):
            print(f"{key}: {value}")
    elif command in ("remember", "forget"):
        if "instructions" not in allowed:
            fail("changing the instructions is not allowed")
        current = lines(data)
        if command == "remember":
            text = " ".join(args[1:]).strip()
            if not text:
                fail("what should I remember?")
            current.append(text)
        else:
            try:
                del current[int(args[1]) - 1]
            except (IndexError, ValueError):
                fail("give the number of a line from «show»")
        data["instructions"] = current
        save(data)
        print("Saved: from the next conversation on." if command == "remember" else "Removed.")
    elif command == "set" and len(args) >= 3:
        key, value = args[1], " ".join(args[2:]).strip()
        if key not in KEYS[1:]:
            fail(f"«{key}» can't be changed; only {', '.join(KEYS[1:])}")
        if key not in allowed:
            fail(f"changing «{key}» is not allowed")
        if key == "face":
            if value not in FACES:
                fail(f"face: {' or '.join(FACES)}")
            data["face"] = value
        elif key == "voice":
            found = voices()
            if value not in found:
                fail(f"there is no voice «{value}» on this Mac")
            if not found[value].startswith(language()):
                fail(f"«{value}» speaks {found[value]}, not {language()}")
            current = data.get("voice")
            current = current if isinstance(current, dict) else ({} if current is None else {language(): current})
            data["voice"] = {**current, language(): value}
        else:
            if not re.fullmatch(r"[^\W\d_]+( [^\W\d_]+)?", value):
                fail("a name is one or two words, letters only")
            data["name"] = value
        save(data)
        print(f"Saved. {'It changes now.' if key == 'face' else 'It restarts after this answer to apply it.'}")
    else:
        fail(f"unknown command; see «{ME} help»")


if __name__ == "__main__":
    main()
