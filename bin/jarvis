#!/bin/sh
# Starts and stops the Jarvis server by hand (no launchd).
#
#   bin/jarvis start [server options]   e.g. --llm hermes, --lang en, --silence 0.45
#   bin/jarvis stop
#   bin/jarvis restart                  (like saying «restart»: stops cleanly and comes back with the same options)
#   bin/jarvis status
#   bin/jarvis log                      (the live log; Ctrl+C to leave)
#   bin/jarvis pair                     a code to pair a device (with "pairing": true)
#   bin/jarvis unpair                   forgets every paired device
#   bin/jarvis skin list|check <folder>|new <name> [--from orb]   the screen's skins
#
# Options also come from settings.json. The PID, the port and the log go to the cache
# folder (.build/ while developing; $JARVIS_CACHE).
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CACHE="${JARVIS_CACHE:-${JARVIS_HOME:-$ROOT}/.build}"  # as server/paths.py
PID="$CACHE/jarvis.pid"
LOG="$CACHE/jarvis.log"
PORTFILE="$CACHE/jarvis.port"

alive() { [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; }

# The port it will listen on: --port, else settings.json's, else 8080.
port_for() {
  /usr/bin/python3 - "$ROOT" "$@" <<'PY'
import json, os, sys
root, args = sys.argv[1], sys.argv[2:]
for i, arg in enumerate(args):
    if arg == "--port" and i + 1 < len(args):
        print(args[i + 1]); sys.exit()
    if arg.startswith("--port="):
        print(arg.split("=", 1)[1]); sys.exit()
try:
    path = os.path.join(os.environ.get("JARVIS_HOME") or root, "settings.json")
    print(json.load(open(path)).get("port", 8080))
except (OSError, ValueError):
    print(8080)
PY
}
PORT=$(cat "$PORTFILE" 2>/dev/null || echo 8080)

case "$1" in
  start)
    shift
    if alive; then echo "Jarvis is already running (PID $(cat "$PID"))."; exit 0; fi
    mkdir -p "$CACHE"
    PORT=$(port_for "$@")
    echo "$PORT" > "$PORTFILE"
    cd "$ROOT" || exit 1
    uv sync --quiet || exit 1
    # The environment's python directly (not `uv run`), so the PID is the server's.
    PYTHONUNBUFFERED=1 nohup "$ROOT/.venv/bin/python" server/main.py "$@" >> "$LOG" 2>&1 &
    echo $! > "$PID"
    printf "Starting Jarvis (PID %s)" "$(cat "$PID")"
    i=0
    while [ $i -lt 120 ]; do
      if curl -s -o /dev/null "http://127.0.0.1:$PORT/"; then echo " · ready at http://127.0.0.1:$PORT"; exit 0; fi
      if ! alive; then echo " · it stopped; see $LOG"; exit 1; fi
      printf "."; sleep 1; i=$((i + 1))
    done
    echo " · taking longer than usual; see $LOG"
    ;;
  stop)
    if ! alive; then echo "Jarvis isn't running."; rm -f "$PID"; exit 0; fi
    P=$(cat "$PID")
    kill -TERM "$P"  # clean shutdown: sessions, Claude, voice
    i=0
    while kill -0 "$P" 2>/dev/null && [ $i -lt 15 ]; do sleep 1; i=$((i + 1)); done
    if kill -0 "$P" 2>/dev/null; then
      echo "It didn't stop within 15 s: forcing it."
      pkill -KILL -P "$P" 2>/dev/null
      kill -KILL "$P" 2>/dev/null
    fi
    rm -f "$PID"
    echo "Jarvis stopped."
    ;;
  restart)
    if ! alive; then echo "Jarvis isn't running: use «$0 start»."; exit 1; fi
    kill -HUP "$(cat "$PID")"
    echo "Restarting Jarvis (same PID, same options)…"
    ;;
  status)
    if alive; then
      echo "Jarvis is running (PID $(cat "$PID")): $(curl -s -m 3 "http://127.0.0.1:$PORT/status" || echo 'no answer')"
    else
      echo "Jarvis isn't running."
    fi
    ;;
  log)
    tail -n 50 -f "$LOG"
    ;;
  pair)
    if ! alive; then echo "Jarvis isn't running."; exit 1; fi
    curl -s -m 3 -X POST "http://127.0.0.1:$PORT/pairing" | /usr/bin/python3 -c '
import json, sys
d = json.load(sys.stdin)
code, minutes = d["code"], d["seconds"] // 60
print("Code: %s  (valid %d minutes; type it on the device)" % (code, minutes))
if not d["pairing"]:
    print("Note: pairing is off, so any device can connect anyway. Turn it on with \"pairing\": true in settings.json.")
'
    ;;
  skin)
    shift
    exec "$ROOT/.venv/bin/python" "$ROOT/server/skins.py" "$@"
    ;;
  unpair)
    if ! alive; then echo "Jarvis isn't running."; exit 1; fi
    curl -s -m 3 -X POST "http://127.0.0.1:$PORT/pairing?forget=1" > /dev/null && echo "Every device forgotten: they'll need a new code."
    ;;
  *)
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
