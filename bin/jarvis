#!/bin/sh
# Arranca y para el servidor de Jarvis a mano (sin launchd).
#
#   bin/jarvis arrancar [opciones del servidor]   p. ej. --llm hermes, --silencio 0.45
#   bin/jarvis parar
#   bin/jarvis reiniciar     (como «Reiníciate»: cierra limpio y se relanza con las mismas opciones)
#   bin/jarvis estado
#   bin/jarvis log           (el registro en vivo; Ctrl+C para salir)
#
# El PID va en .build/jarvis.pid y el registro en .build/jarvis.log.
RAIZ="$(cd "$(dirname "$0")/.." && pwd)"
PID="$RAIZ/.build/jarvis.pid"
LOG="$RAIZ/.build/jarvis.log"
PUERTO=8080

vivo() { [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; }

case "$1" in
  arrancar)
    shift
    if vivo; then echo "Jarvis ya está en marcha (PID $(cat "$PID"))."; exit 0; fi
    mkdir -p "$RAIZ/.build"
    cd "$RAIZ" || exit 1
    uv sync --quiet || exit 1
    # El python del entorno directamente (no `uv run`), para que el PID sea el del servidor.
    PYTHONUNBUFFERED=1 nohup "$RAIZ/.venv/bin/python" server/main.py "$@" >> "$LOG" 2>&1 &
    echo $! > "$PID"
    printf "Arrancando Jarvis (PID %s)" "$(cat "$PID")"
    i=0
    while [ $i -lt 120 ]; do
      if curl -s -o /dev/null "http://127.0.0.1:$PUERTO/"; then echo " · listo en http://127.0.0.1:$PUERTO"; exit 0; fi
      if ! vivo; then echo " · se ha parado; mira $LOG"; exit 1; fi
      printf "."; sleep 1; i=$((i + 1))
    done
    echo " · tarda más de lo normal; mira $LOG"
    ;;
  parar)
    if ! vivo; then echo "Jarvis no está en marcha."; rm -f "$PID"; exit 0; fi
    P=$(cat "$PID")
    kill -TERM "$P"  # cierre limpio: sesiones, Claude, voz
    i=0
    while kill -0 "$P" 2>/dev/null && [ $i -lt 15 ]; do sleep 1; i=$((i + 1)); done
    if kill -0 "$P" 2>/dev/null; then
      echo "No se ha cerrado en 15 s: lo fuerzo."
      pkill -KILL -P "$P" 2>/dev/null
      kill -KILL "$P" 2>/dev/null
    fi
    rm -f "$PID"
    echo "Jarvis parado."
    ;;
  reiniciar)
    if ! vivo; then echo "Jarvis no está en marcha: usa «$0 arrancar»."; exit 1; fi
    kill -HUP "$(cat "$PID")"
    echo "Reiniciando Jarvis (mismo PID, mismas opciones)…"
    ;;
  estado)
    if vivo; then
      echo "Jarvis en marcha (PID $(cat "$PID")): $(curl -s -m 3 "http://127.0.0.1:$PUERTO/estado" || echo 'sin respuesta')"
    else
      echo "Jarvis no está en marcha."
    fi
    ;;
  log)
    tail -n 50 -f "$LOG"
    ;;
  *)
    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
