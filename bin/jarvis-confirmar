#!/usr/bin/python3
"""Hook PreToolUse de Claude Code: las acciones que escriben necesitan el «sí» del usuario.

Claude Code lo ejecuta antes de cada herramienta, con {tool_name, tool_input}
por stdin. Si la acción escribe (bin/gog que no sea de lectura, o una
herramienta MCP que no sea get_/list_/search_…) y el usuario no la ha
confirmado, la bloquea (código 2: el mensaje le llega a Claude) y la apunta
en .build/confirmar/pendiente.json. Cuando el usuario dice «sí», el servidor
de voz (cerebro/asistente.py) escribe confirmada.json con la misma firma, y la
misma llamada, repetida en el siguiente minuto, pasa una sola vez.

Claude no puede falsificarlo: no tiene herramientas para escribir archivos y
su terminal solo ejecuta los comandos permitidos.
"""

import hashlib
import json
import os
import shlex
import sys
import time

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CARPETA = os.path.join(RAIZ, ".build", "confirmar")
PENDIENTE = os.path.join(CARPETA, "pendiente.json")
CONFIRMADA = os.path.join(CARPETA, "confirmada.json")

# Órdenes de gog que solo leen (servicio, orden); lo demás se trata como escritura.
GOG_LECTURA = {
    ("gmail", "search"), ("gmail", "find"), ("gmail", "query"), ("gmail", "ls"), ("gmail", "list"),
    ("gmail", "get"), ("gmail", "info"), ("gmail", "show"), ("gmail", "thread"), ("gmail", "labels"),
    ("gmail", "url"), ("gmail", "history"),
    ("calendar", "calendars"), ("calendar", "events"), ("calendar", "list"), ("calendar", "ls"),
    ("calendar", "event"), ("calendar", "get"), ("calendar", "info"), ("calendar", "show"),
    ("calendar", "freebusy"), ("calendar", "conflicts"), ("calendar", "colors"),
    ("drive", "ls"), ("drive", "search"), ("drive", "get"), ("drive", "tree"), ("drive", "du"),
    ("drive", "permissions"),
    ("docs", "cat"), ("docs", "text"), ("docs", "read"), ("docs", "info"), ("docs", "get"),
    ("docs", "show"), ("docs", "list-tabs"),
    ("sheets", "get"), ("sheets", "read"), ("sheets", "show"),
    ("contacts", "list"), ("contacts", "search"), ("contacts", "get"),
    ("tasks", "list"), ("tasks", "lists"),
}
MCP_LECTURA = ("get_", "list_", "search_", "find_", "preview_", "download_")


def descripcion_gog(comando):
    """La acción de bin/gog en palabras, o None si solo lee."""
    try:
        partes = shlex.split(comando)
    except ValueError:
        return comando
    if not partes or not partes[0].endswith("bin/gog"):
        return None
    palabras = [p for p in partes[1:] if not p.startswith("-")]
    if palabras[:1] == ["ayuda"] or "--help" in partes or "-h" in partes:
        return None
    if tuple(palabras[:2]) in GOG_LECTURA:
        return None
    return " ".join(partes[1:])


def descripcion(herramienta, entrada):
    if herramienta == "Bash":
        return descripcion_gog(entrada.get("command", ""))
    if herramienta.startswith("mcp__"):
        nombre = herramienta.split("__")[-1]
        if nombre.startswith(MCP_LECTURA):
            return None
        return f"{herramienta.split('__')[1]}: {nombre} {json.dumps(entrada, ensure_ascii=False)}"
    return None


def leer(ruta):
    try:
        with open(ruta) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def main():
    datos = json.load(sys.stdin)
    herramienta, entrada = datos.get("tool_name", ""), datos.get("tool_input", {})
    accion = descripcion(herramienta, entrada)
    if accion is None:
        sys.exit(0)

    firma = hashlib.sha256(json.dumps([herramienta, entrada], sort_keys=True).encode()).hexdigest()
    confirmada = leer(CONFIRMADA)
    if confirmada and confirmada.get("firma") == firma and confirmada.get("hasta", 0) > time.time():
        os.remove(CONFIRMADA)  # vale para una sola vez
        sys.exit(0)

    os.makedirs(CARPETA, exist_ok=True)
    with open(PENDIENTE, "w") as f:
        json.dump({"firma": firma, "accion": accion, "cuando": time.time()}, f, ensure_ascii=False)
    print(
        "Esta acción modifica datos y necesita confirmación del usuario. No la des por hecha: "
        "pregúntale en una frase corta si quiere hacerlo (di qué vas a hacer). Si responde que sí, "
        "repite exactamente la misma llamada; si no, no la hagas.",
        file=sys.stderr,
    )
    sys.exit(2)


if __name__ == "__main__":
    main()
